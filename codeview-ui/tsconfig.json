{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["svelte", "node", "$app/types"],
    "paths": {
      "#lib": ["./src/lib/index.ts"],
      "#lib/*": ["./src/lib/*"],
      "$cloudflare": ["./src/lib/server/cloudflare"],
      "$cloudflare/*": ["./src/lib/server/cloudflare/*"],
      "$provider": ["./src/lib/server/local/provider.ts"],
      "$realtime": ["./src/lib/ws/client.ts"]
    }
  },
  "include": [
    "$app/ambient.d.ts",
    "$app/non-ambient.d.ts",
    "$app/types/**/$types.d.ts",
    "vite.config.js",
    "vite.config.ts",
    "alchemy.run.ts",
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.svelte",
    "tests/**/*.js",
    "tests/**/*.ts",
    "tests/**/*.svelte"
  ],
  "exclude": [
    "src/lib/wasm/**",
    "src/service-worker.ts",
    ".svelte-kit/output/**",
    ".svelte-kit/cloudflare/**",
    ".svelte-kit/cloudflare-tmp/**"
  ]
}
